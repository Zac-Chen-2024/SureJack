<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      启动图主题（Android 12 SplashScreen API，core-splashscreen 向下兼容）。
      MainActivity 会把启动图一直держ到网页加载完才淡出，消灭"启动图没了、
      页面还没来"的空档——这正是 TWA 时代做不到的事。
    -->
    <style name="Theme.SureJack.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/sj_splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">400</item>
        <item name="postSplashScreenTheme">@style/Theme.SureJack</item>
    </style>

    <style name="Theme.SureJack" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/sj_bg</item>
        <item name="android:statusBarColor">@color/sj_bg</item>
        <item name="android:navigationBarColor">@color/sj_black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
